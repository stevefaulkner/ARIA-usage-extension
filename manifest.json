{
  "manifest_version": 3,
  "name": "WAI-ARIA Usage",
  "version": "1.0.0",
  "description": "Evaluate a page's WAI-ARIA usage against the ARIA in HTML specification and open the results in a new tab.",
  "minimum_chrome_version": "112",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Evaluate WAI-ARIA usage",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "run-aria-usage": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Evaluate WAI-ARIA usage on the current page"
    }
  }
}
